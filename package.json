{
  "name": "node-modules-sweeper",
  "version": "0.2.7",
  "type": "module",
  "description": "Scan and selectively clean node_modules directories — interactive ink TUI",
  "bin": {
    "nms": "bin/nms.js"
  },
  "exports": "./dist/cli.js",
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "engines": { "node": ">=22" },
  "keywords": [
    "node_modules",
    "clean",
    "sweep",
    "disk",
    "space",
    "cli",
    "tui",
    "ink",
    "prune"
  ],
  "license": "MIT",
  "author": "huajuan-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huajuan-labs/node-modules-sweeper.git"
  },
  "homepage": "https://github.com/huajuan-labs/node-modules-sweeper#readme",
  "bugs": {
    "url": "https://github.com/huajuan-labs/node-modules-sweeper/issues"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
